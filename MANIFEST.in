# setuptools_scm will ensure all files tracked by git are included

include pyocd/debug/svd/svd_data.zip
include pyocd/debug/sequences/sequences.lark
include pyocd/probe/raspberry_pi/_bcm_gpio.c
recursive-exclude pyocd/debug/svd/data *
global-exclude __pycache__ *.py[cod] .* .DS_Store
prune .github
prune .azure
prune scripts
